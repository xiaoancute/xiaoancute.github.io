# 结构元素一律用 DEFAULT，直接沿用终端自己的前景/背景色，不强推一套配色。
# 但「当前选中项」和「当前按钮」必须看得出来，否则光标在哪全靠猜 ——
# 这两处用终端调色板里的 CYAN 反白，仍然跟随用户的主题。
# 注意：use_colors = OFF 会让 dialog 走单色路径，此时下面所有颜色设置全部失效、
# 选中项和普通项渲染得一模一样，所以这里必须是 ON。

use_shadow = OFF
use_colors = ON

screen_color                = (DEFAULT,DEFAULT,OFF)
shadow_color                = (DEFAULT,DEFAULT,OFF)
dialog_color                = (DEFAULT,DEFAULT,OFF)
title_color                 = (CYAN,DEFAULT,ON)
border_color                = (DEFAULT,DEFAULT,OFF)
border2_color               = (DEFAULT,DEFAULT,OFF)

button_inactive_color       = (DEFAULT,DEFAULT,OFF)
button_label_inactive_color = (DEFAULT,DEFAULT,OFF)
button_key_inactive_color   = (DEFAULT,DEFAULT,OFF)
button_active_color         = (BLACK,CYAN,ON)
button_label_active_color   = (BLACK,CYAN,ON)
button_key_active_color     = (BLACK,CYAN,ON)

inputbox_color              = (DEFAULT,DEFAULT,OFF)
inputbox_border_color       = (DEFAULT,DEFAULT,OFF)
searchbox_color             = (DEFAULT,DEFAULT,OFF)
searchbox_title_color       = (CYAN,DEFAULT,ON)
searchbox_border_color      = (DEFAULT,DEFAULT,OFF)
position_indicator_color    = (CYAN,DEFAULT,ON)

menubox_color               = (DEFAULT,DEFAULT,OFF)
menubox_border_color        = (DEFAULT,DEFAULT,OFF)
menubox_border2_color       = (DEFAULT,DEFAULT,OFF)
item_color                  = (DEFAULT,DEFAULT,OFF)
item_selected_color         = (BLACK,CYAN,ON)
tag_color                   = (DEFAULT,DEFAULT,OFF)
tag_selected_color          = (BLACK,CYAN,ON)
tag_key_color               = (DEFAULT,DEFAULT,OFF)
tag_key_selected_color      = (BLACK,CYAN,ON)

check_color                 = (DEFAULT,DEFAULT,OFF)
check_selected_color        = (BLACK,CYAN,ON)
uarrow_color                = (CYAN,DEFAULT,ON)
darrow_color                = (CYAN,DEFAULT,ON)
itemhelp_color              = (DEFAULT,DEFAULT,OFF)

form_text_color             = (DEFAULT,DEFAULT,ON)
form_active_text_color      = (BLACK,CYAN,ON)
form_item_readonly_color    = (DEFAULT,DEFAULT,OFF)
gauge_color                 = (CYAN,DEFAULT,ON)
